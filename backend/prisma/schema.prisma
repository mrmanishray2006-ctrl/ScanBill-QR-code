datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  STAFF
  CUSTOMER
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum CouponType {
  REFERRAL
  LOYALTY
  GENERAL
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String
  passwordHash       String
  role               UserRole   @default(CUSTOMER)
  refreshTokenHash   String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  isDeleted          Boolean    @default(false)

  // Relationships
  storesOwned        Store[]    @relation("StoreOwner")
  employeeProfile    Employee?
  orders             Order[]
  loyaltyProfile     LoyaltyCard[]
  auditLogs          AuditLog[]

  @@index([email])
}

model Store {
  id                 String            @id @default(uuid())
  ownerId            String
  name               String
  address            String
  logoUrl            String?
  paymentUpiId       String
  merchantName       String
  razorpayKeyId      String?
  razorpayKeySecret  String?
  subscriptionPlan   SubscriptionPlan  @default(STARTER)
  subscriptionStatus String            @default("active") // active, expired
  subscriptionExpiresAt DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  isDeleted          Boolean           @default(false)

  // Relationships
  owner              User              @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  employees          Employee[]
  products           Product[]
  orders             Order[]
  coupons            Coupon[]
  subscriptions      SubscriptionLog[]
  loyaltyCards       LoyaltyCard[]

  @@index([ownerId])
}

model Employee {
  id               String       @id @default(uuid())
  userId           String       @unique
  storeId          String
  role             UserRole     @default(STAFF)
  permissions      String[]     // JSON-like array of specific permission keys
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  isDeleted        Boolean      @default(false)

  // Relationships
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attendance       Attendance[]

  @@index([storeId])
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  date        DateTime         @default(now())
  checkIn     DateTime         @default(now())
  checkOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  createdAt   DateTime         @default(now())

  // Relationships
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model Product {
  id             String      @id @default(uuid())
  storeId        String
  name           String
  sku            String
  category       String
  description    String?
  price          Float
  stockQty       Int
  reorderPoint   Int         @default(10)
  isActive       Boolean     @default(true)
  imageUrl       String?
  gstPercent     Float       @default(18.0)
  discountPercent Float      @default(0.0)
  expiryDate     DateTime?
  scansCount     Int         @default(0)
  salesGenerated Float       @default(0.0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  isDeleted      Boolean     @default(false)

  // Relationships
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@unique([storeId, sku])
  @@index([storeId, sku])
  @@index([category])
}

model Order {
  id             String         @id @default(uuid())
  storeId        String
  customerId     String?
  customerName   String
  customerEmail  String
  invoiceNumber  String         @unique
  subtotal       Float
  tax            Float
  discount       Float
  total          Float
  paymentStatus  PaymentStatus  @default(PENDING)
  paymentMethod  PaymentMethod  @default(UPI)
  txRef          String?
  offlineSynced  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relationships
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer       User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([storeId])
  @@index([customerId])
  @@index([invoiceNumber])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String?
  name           String
  price          Float
  quantity       Int
  tax            Float
  discount       Float
  subtotal       Float

  // Relationships
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model LoyaltyCard {
  id             String   @id @default(uuid())
  customerId     String
  storeId        String
  points         Int      @default(0)
  tier           String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  referralCode   String   @unique
  referredById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  customer       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([customerId, storeId])
  @@index([customerId, storeId])
}

model Coupon {
  id              String     @id @default(uuid())
  storeId         String
  code            String
  discountPercent Float
  maxDiscount     Float?
  minBillAmount   Float      @default(0.0)
  expiresAt       DateTime
  isActive        Boolean    @default(true)
  type            CouponType @default(GENERAL)
  createdAt       DateTime   @default(now())

  // Relationships
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId, code])
}

model SubscriptionLog {
  id          String           @id @default(uuid())
  storeId     String
  plan        SubscriptionPlan
  amount      Float
  startDate   DateTime         @default(now())
  endDate     DateTime
  status      String           @default("active") // active, expired
  txId        String
  createdAt   DateTime         @default(now())

  // Relationships
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  details     String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relationships
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
